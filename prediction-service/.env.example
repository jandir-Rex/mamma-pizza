# Clave compartida con el backend Node (debe ser la MISMA que PREDICTION_SERVICE_KEY en el .env del backend)
SERVICE_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# IA en la nube (opcional). Sin clave, el motor estadistico funciona igual.
GEMINI_API_KEY=
# Modelo configurable: revisa en Google AI Studio cuales estan disponibles en tu cuenta
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=25
